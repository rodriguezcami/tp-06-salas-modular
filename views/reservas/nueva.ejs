<h1><%= seccion %>: nueva reserva</h1>

<form class="formulario" action="/reservas" method="post" novalidate>
  <% if (errores.length > 0) { %>
    <div class="alerta-error" role="alert">
      <p>No se pudo guardar la reserva:</p>
      <ul>
        <% errores.forEach((error) => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <div class="campo">
    <label for="estudiante">Estudiante</label>
    <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante || '' %>">
  </div>

  <div class="campo">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= valores.email || '' %>">
  </div>

  <div class="campo">
    <label for="sala">Sala</label>
    <select id="sala" name="sala">
      <option value="">Elegí una sala</option>
      <% salasPermitidas.forEach((sala) => { %>
        <option value="<%= sala %>" <%= valores.sala === sala ? 'selected' : '' %>><%= sala %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="fecha">Fecha</label>
    <input type="date" id="fecha" name="fecha" value="<%= valores.fecha || '' %>">
  </div>

  <div class="campo">
    <label for="turno">Turno</label>
    <select id="turno" name="turno">
      <option value="">Elegí un turno</option>
      <% turnosPermitidos.forEach((turno) => { %>
        <option value="<%= turno %>" <%= valores.turno === turno ? 'selected' : '' %>><%= turno %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="personas">Cantidad de personas (1 a 6)</label>
    <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas || '' %>">
  </div>

  <button class="boton" type="submit">Guardar reserva</button>
</form>